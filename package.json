{
  "name": "musdi",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "geo:process": "bun run scripts/process-geojson.ts",
    "geo:validate": "bun run scripts/validate-districts.ts",
    "data:fetch": "bun run scripts/fetch-artists.ts",
    "data:resolve": "bun run scripts/resolve-districts.ts",
    "data:enrich": "bun run scripts/enrich-artists.ts",
    "data:validate": "bun run scripts/validate-artists.ts",
    "data:generate": "bun run scripts/generate-data.ts",
    "data:refresh": "bun run scripts/fetch-artists.ts && bun run scripts/resolve-districts.ts && bun run scripts/enrich-artists.ts && bun run scripts/generate-data.ts && bun run scripts/validate-artists.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-three/drei": "^10.7.9",
